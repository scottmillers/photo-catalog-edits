{
    "name": "photo-catalog-edits",
    "image": "mcr.microsoft.com/devcontainers/base:noble",
    // "postCreateCommand": "sudo apt-get update && sudo apt-get install -y graphviz",// install graphviz for AWS MCP Diagram server
    //"postCreateCommand": "pipx install checkov",
   
 
    "mounts": [
        // Example 1: Mount your entire host Home directory into the container
        "source=${localEnv:HOME}${localEnv:USERPROFILE},target=/host-home,type=bind,consistency=cached",

        // Maps the host Z: drive to /mnt/photos inside the container
        "source=Z:\\,target=/workspaces/photos,type=bind,consistency=cached"
    ],
    "features": {
        "ghcr.io/devcontainers/features/python:1": {}
    }
    
}